# Settings for the local AI analyzer (AI_Log_Analyzer) and the dashboard.
# All are optional: the defaults below work when Ollama runs on the same machine.
# These are read from environment variables (this file is not loaded automatically). Set them like this:
#   Windows PowerShell:   $env:OLLAMA_URL = "http://127.0.0.1:11434"
#   Linux/macOS:          export OLLAMA_URL="http://127.0.0.1:11434"
# Never commit a real .env file (it is in .gitignore).

# Where the Ollama server runs. Only loopback or private LAN addresses are accepted (e.g. http://192.168.1.50:11434).
OLLAMA_URL=http://127.0.0.1:11434

# Which local model explains incidents (download it first with: ollama pull qwen3:4b).
OLLAMA_MODEL=qwen3:4b

# Seconds to wait for one answer from the model (CPU inference can be slow).
OLLAMA_TIMEOUT=120

# Server side only, on the machine that hosts Ollama for teammates on the same trusted LAN:
#   OLLAMA_HOST=0.0.0.0:11434   (see frontend/README.md for the firewall rules first)
